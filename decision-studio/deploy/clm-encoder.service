[Unit]
Description=Qwen3 Encoder for CLM
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/decision-studio/clm
Environment=HF_HOME=/opt/decision-studio/models
ExecStart=/opt/decision-studio/venv/bin/vllm serve Qwen/Qwen3-8B --served-model-name qwen3-8b --runner pooling --max-model-len 2048 --host 127.0.0.1 --port 8090
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
