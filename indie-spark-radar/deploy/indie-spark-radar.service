[Unit]
Description=Indie Spark Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/app/indie-spark-radar/current
EnvironmentFile=/etc/indie-spark-radar/indie-spark.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
