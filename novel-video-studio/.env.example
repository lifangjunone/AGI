# Keep real credentials in .env.local. Never commit that file.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_PLANNING_MODEL=glm-5-2-260617
ARK_IMAGE_MODEL=
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628

# demo performs the complete workflow without billable model calls.
PRODUCTION_MODE=demo
ALLOW_BILLABLE_GENERATION=false
ALLOW_BUDGET_OVERRUN=false
PORT=4321
DAILY_OUTPUT_HOURS=72
EPISODE_DURATION_MINUTES=15
SHOT_DURATION_SECONDS=30
MAX_PROJECT_CONCURRENCY=2
MAX_VIDEO_CONCURRENCY=4
DAILY_BUDGET_CNY=200
# 720P text-to-video reference estimate; verify against the current Ark price page.
VIDEO_COST_PER_SECOND_CNY=1.512

# Optional. Adds broad web discovery; public-domain sources still take priority.
BRAVE_SEARCH_API_KEY=
DOMESTIC_WEB_SEARCH=true
NOVEL_SOURCE_CONFIG=
FFMPEG_PATH=
FFPROBE_PATH=
