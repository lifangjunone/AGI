[Unit]
Description=Duix replica static site
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/app/duix-replica/current
ExecStart=/usr/bin/python3 -m http.server 4396 --bind 127.0.0.1 --directory /data/app/duix-replica/current
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
