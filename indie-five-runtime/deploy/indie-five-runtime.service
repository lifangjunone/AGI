[Unit]
Description=Indie Five Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/data/app/indie-five-runtime/current
EnvironmentFile=/etc/indie-five-runtime/app.env
ExecStart=/usr/bin/python3 app/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
