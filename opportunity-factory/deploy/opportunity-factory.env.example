OPPORTUNITY_FACTORY_HOME=/data/app/opportunity-factory/runtime
FACTORY_HOST=127.0.0.1
FACTORY_PORT=8787
PUBLIC_URL=https://audit.lifeyoume.icu
SCAN_SECONDS=900
ADMIN_PASSWORD=replace-with-a-long-random-password
IP_HASH_SALT=replace-with-a-long-random-salt

# Optional. Use a dedicated GitHub account/token, never a personal broad-scope token.
# GITHUB_TOKEN=
# ALLOW_AUTONOMOUS_OUTREACH=0

# Merchant checkout. Without this, the site records purchase intent but cannot charge.
# CHECKOUT_URL=
# Stripe automatic checkout and post-payment report unlock.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# REPORT_PRICE_CENTS=29900
# REPORT_CURRENCY=cny

# Recommended for global digital-product checkout. Lemon Squeezy is the
# merchant of record and can show cards, PayPal, Alipay, and WeChat Pay when
# eligible. The webhook unlocks only a paid, non-test order whose variant and
# USD subtotal exactly match these values.
# LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-variant
# LEMONSQUEEZY_VARIANT_ID=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# REPORT_PRICE_USD_CENTS=3900

# Optional stable search-submission key. A deterministic key is used by default.
# INDEXNOW_KEY=
