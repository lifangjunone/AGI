{
  "version": 1,
  "productName": "Hermes Cognitive Evolution Engine",
  "repository": "https://github.com/NousResearch/hermes-agent",
  "runtime": {
    "mode": "cli",
    "command": "~/.local/bin/hermes",
    "sessionPrefix": "easysay-",
    "maxTurns": 1,
    "timeoutSeconds": 120
  },
  "privacy": {
    "sendAudio": false,
    "sendTranscripts": true,
    "sendScores": true,
    "sendCourseStructure": true
  },
  "defaults": {
    "enabled": false,
    "autoEvolve": true,
    "recordsPerCycle": 3,
    "maxAdjustedWeeks": 6
  }
}
