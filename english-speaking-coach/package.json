{
  "name": "english-speaking-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\" \"npm:speech:start\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "mobile:start": "bash scripts/start-mobile.sh",
    "mobile:server": "tsx server/index.ts",
    "mobile:bootstrap": "tsx server/mobileBootstrap.ts",
    "mobile:doctor": "bash scripts/doctor-mobile.sh",
    "native:start": "bash scripts/start-native-app-server.sh",
    "native:server": "tsx server/index.ts",
    "native:sync": "npm run build && cap sync",
    "native:ios": "npm run native:sync && cap open ios",
    "ios:doctor": "bash scripts/doctor-ios.sh",
    "ios:install": "bash scripts/install-ios.sh",
    "native:android": "npm run native:sync && cap open android",
    "speech:setup": "bash scripts/setup-speech-models.sh",
    "speech:start": "bash scripts/start-speech-service.sh",
    "speech:doctor": "bash scripts/doctor-speech-models.sh",
    "speech:test": ".venv-speech/bin/python -m unittest speech.test_service",
    "llm:setup": "bash scripts/setup-local-llm.sh",
    "llm:download": "bash scripts/download-local-llm.sh",
    "llm:start": "bash scripts/start-local-llm.sh",
    "llm:doctor": "bash scripts/doctor-local-llm.sh",
    "hermes:setup": "bash scripts/setup-hermes-agent.sh",
    "hermes:doctor": "bash scripts/doctor-hermes-agent.sh",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.539.0",
    "openai": "^5.12.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4"
  }
}
