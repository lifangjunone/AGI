[Unit]
Description=LifeYouMe Product Image Batch Studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=income-engine
Group=income-engine
WorkingDirectory=/data/app/autonomous-income-engine/current
EnvironmentFile=/data/app/autonomous-income-engine/shared/runtime.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4188
Environment=ADAPTERS_FROM_ENV=1
Environment=PUBLIC_BASE_URL=https://lifeyoume.icu/image
Environment=DEPLOY_PUBLIC_BASE_URL=https://lifeyoume.icu/image
Environment=TRUST_PROXY=1
Environment=PAYMENT_AUTOSYNC=1
Environment=PAYMENT_SYNC_INTERVAL_SECONDS=15
Environment=COMMERCE_AUTORUN=1
Environment=COMMERCE_INTERVAL_SECONDS=900
Environment=PUBLIC_ACCESS_MONITOR=0
Environment=REQUIRE_PAYMENT_WEBHOOK_SECRET=1
Environment=REQUIRE_ADMIN_API_SECRET=1
Environment=REQUIRE_AUTHORITATIVE_PAYMENT_SOURCE=1
Environment=AIE_DATA_DIR=/data/app/autonomous-income-engine/shared/data
Environment=AIE_RUNTIME_DIR=/data/app/autonomous-income-engine/shared/runtime
Environment=AIE_DIST_DIR=/data/app/autonomous-income-engine/shared/dist
Environment=AIE_PUBLIC_SITE_DIR=/data/app/autonomous-income-engine/shared/public-site
Environment=WECHAT_QR_PATH=/data/app/autonomous-income-engine/shared/private/wechat-pay.jpg
ExecStart=/usr/bin/node /data/app/autonomous-income-engine/current/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/app/autonomous-income-engine/shared

[Install]
WantedBy=multi-user.target
