NODE_ENV=development
PORT=43180
WEB_ORIGIN=http://localhost:43181
PUBLIC_APP_URL=http://localhost:43181
DATABASE_URL=postgres://meyou:meyou@localhost:5438/meyou
REDIS_URL=redis://localhost:6383
API_INTERNAL_URL=http://127.0.0.1:43180
WORKER_INTERNAL_TOKEN=replace-with-a-separate-random-32-byte-token
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@lifeyoume.icu
# Generate this value with the command documented in README.md. Never store a plaintext password here.
ADMIN_PASSWORD_HASH=
# Use an independent random secret of at least 32 characters in production.
MODEL_CONFIG_ENCRYPTION_KEY=
AUTH_ME_URL=https://auth.lifeyoume.icu/api/v1/me
AUTH_ADMIN_CHECK_URL=https://auth.lifeyoume.icu/api/v1/admin/access/check
AUTH_LOGIN_URL=https://auth.lifeyoume.icu/login
DEV_AUTH_BYPASS=true
# Default preserves existing database/provider configuration.
MODEL_PROVIDER_MODE=legacy
# Opt-in MaaS: set mode=maas AND MODEL_TIMEOUT_MS=120000 (3000..120000).
# This URL already includes /v1. Keep the application key in server Secrets only.
MAAS_BASE_URL=https://maas.lifeyoume.icu/v1
MEYOU_MAAS_MODEL_ID=lym-chat-quality
MEYOU_MAAS_SERVICE_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# At least 32 random characters. Lets trusted LifeYouMe services import the
# active model connection without exposing it to browsers or source control.
MODEL_CONFIG_SYNC_TOKEN=
ARK_API_KEY=
ARK_MODEL_ID=deepseek-v4-flash-ga-260731
# Legacy timeout; must be reduced to <=120000 when opting into MaaS.
MODEL_TIMEOUT_MS=1800000
LOG_LEVEL=info
# Opt in only when the customer task worker is running and reception has been verified.
CUSTOMER_AGENT_ENABLED=false
# Optional comma-separated organization UUIDs for a restricted invite beta.
CUSTOMER_AGENT_ORGANIZATIONS=
