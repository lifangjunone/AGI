{
  "name": "model-operations-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform local-first model operations and serving console",
  "author": "LifeYouMe",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node server/control-plane.mjs",
    "desktop": "electron electron/main.mjs",
    "benchmark:wan": "node scripts/benchmark-wan.mjs",
    "build": "tsc -b && vite build",
    "desktop:pack": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.lifeyoume.modelops",
    "productName": "Model Operations Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "data/**/*",
      "workflows/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
