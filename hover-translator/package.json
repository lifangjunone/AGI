{
  "name": "hover-translator",
  "private": true,
  "version": "0.1.0",
  "description": "System-wide hover and selection translator for macOS.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "native:build": "mkdir -p native/bin && swiftc native/Sources/HoverOCR/main.swift -O -framework AppKit -framework Vision -framework CoreGraphics -o native/bin/hover-ocr",
    "dev": "npm run native:build && concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5178 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5178 electron .",
    "build": "npm run native:build && tsc -b && vite build",
    "start": "electron .",
    "test": "node --test electron/*.test.cjs",
    "typecheck": "tsc -b --pretty false",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "bing-translate-api": "^4.2.1",
    "lucide-react": "^0.539.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "44.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.lifeyoume.hovertranslator",
    "productName": "Hover Translator",
    "asarUnpack": [
      "native/bin/hover-ocr"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "native/bin/hover-ocr",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Hover Translator reads the words beneath your pointer and text you select so it can translate them."
      },
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
