# 火山方舟（豆包/GLM，OpenAI 兼容接口）
ARK_API_KEY=在此填入你的方舟 API Key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 可填模型名或推理接入点 ID（形如 ep-xxxxxxxx）
ARK_MODEL=glm-5-2-260617

# 每天生成时间（cron 表达式，默认每天 08:00，服务器本地时区）
SCHEDULE_CRON=0 8 * * *
TIMEZONE=Asia/Shanghai

# Web 预览服务端口
PORT=8210

# 文章语言/定位
BRIEF_TOPIC=FDE 现场交付（企业 AI 部署、智能体落地、LLM 工程化）
