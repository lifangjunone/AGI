# Local secrets: copy to .env.local and fill values. Never commit .env.local.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Reuse non-public capability configuration from an existing local project.
# Values in .env.local override values loaded from this file.
REFERENCE_ENV_FILE=

# Language and multimodal understanding
ARK_LLM_MODEL=glm-5-2-260617
# GLM 5.2 has been verified to accept image input and can provide the
# production visual-quality gate without a separate endpoint.
ARK_MULTIMODAL_MODEL=glm-5-2-260617

# Image and primary video generation
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
SEEDANCE_MULTIMODAL_REFERENCES=true
SEEDANCE_CROSS_EPISODE_VIDEO_REFERENCE=true
SEEDANCE_MAX_REFERENCE_IMAGES=30

# Speech recognition
ASR_API_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
ASR_API_KEY=
ASR_MODEL=volc.seedasr.sauc.duration

# Self-hosted Qwen3-TTS service (no API key required on the trusted network).
TTS_API_URL=http://your-gpu-host:7861
TTS_MODEL=Qwen3-TTS-12Hz-1.7B-CustomVoice
TTS_DEFAULT_SPEAKER=Uncle_Fu

# OpenAI-compatible fallback video endpoint returning data:video/mp4;base64,...
FALLBACK_VIDEO_API_URL=
FALLBACK_VIDEO_API_KEY=
FALLBACK_VIDEO_MODEL=

# Optional relevance and timestamp helpers
RERANK_API_URL=
RERANK_API_KEY=
RERANK_MODEL=
TIMESTAMP_API_URL=
TIMESTAMP_API_KEY=
TIMESTAMP_MODEL=

# Safety and budget gates
ALLOW_BILLABLE_GENERATION=false
DAILY_BUDGET_CNY=200
# Used only for preflight estimates until the provider usage API returns actual billing.
VIDEO_COST_CNY_PER_SECOND=
MAX_MODEL_CONCURRENCY=5
MODEL_REQUEST_TIMEOUT_MS=120000
