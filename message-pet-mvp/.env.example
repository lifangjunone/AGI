# 飞书事件订阅页面中的 Verification Token。
FEISHU_VERIFICATION_TOKEN=replace-with-your-verification-token

# 当前用户的飞书 Open ID，用于准确判断群消息是否 @了本人。
FEISHU_CURRENT_USER_OPEN_ID=ou_xxxxxxxxxxxxx

# 独立运行 Web 服务时可覆盖监听地址与端口。
HOST=127.0.0.1
PORT=4173

# 可选：覆盖本地持久化数据目录。
# MESSAGE_PET_DATA_DIR=/absolute/path/to/message-pet-data
