{
  "name": "trend-forum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A community-style website for daily trend aggregation, scheduled publishing, and editorial posts.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:portal": "TREND_FORUM_BASE=/trends/ vite build",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "bash deploy/push-static.sh",
    "sync:trends": "node scripts/sync-technology-report.mjs",
    "publish:daily": "node scripts/publish-daily.mjs",
    "prepare:daily": "npm run sync:trends && npm run publish:daily"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  }
}
