[Unit]
Description=FRAME/60 product content studio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opportunity
Group=opportunity
WorkingDirectory=/data/app/short-video-studio
Environment=NODE_ENV=production
Environment=PORT=4321
Environment=HOST=127.0.0.1
Environment=FRAME60_PUBLIC_BASE_PATH=/video
Environment=FRAME60_PUBLIC_ORIGIN=https://lifeyoume.icu/video
EnvironmentFile=-/data/app/short-video-studio/.admin.env
EnvironmentFile=-/data/app/short-video-studio/.env.local
Environment=ALIPAY_ENV=production
Environment=ALIPAY_APP_ID=2021006197631772
Environment=ALIPAY_PRIVATE_KEY_FILE=/data/app/opportunity-factory/private/alipay-app-private-key.pem
Environment=ALIPAY_PUBLIC_KEY_FILE=/data/app/opportunity-factory/private/alipay-public-key.pem
Environment=ALIPAY_SELLER_ID=2088122111133366
Environment=ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
Environment=ALIPAY_NOTIFY_URL=https://lifeyoume.icu/video/api/alipay/notify
Environment=ALIPAY_MOBILE_WAP_ENABLED=true
Environment=CONTENT_PACK_PRICE=1.00
ExecStart=/opt/node20/bin/node /data/app/short-video-studio/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/app/short-video-studio/data

[Install]
WantedBy=multi-user.target
